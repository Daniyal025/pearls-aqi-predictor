# =====================================================================
# Pearls AQI Predictor - environment variables (EXAMPLE)
# Copy this file to ".env" and fill in REAL values. Never commit ".env".
# =====================================================================

# --- OpenWeather ---
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- MongoDB Atlas ---
# Get this from Atlas -> Connect -> Drivers -> Python
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=pearls_aqi

# --- Target city (configurable) ---
CITY_NAME=Karachi
LATITUDE=24.8607
LONGITUDE=67.0011
TIMEZONE=Asia/Karachi

# --- API base URL used by the Streamlit dashboard to reach FastAPI ---
API_BASE_URL=http://127.0.0.1:8000
